# Vacias = rutas relativas (usa el proxy de vite.config.js hacia el backend). Solo se llenan si
# el backend vive en otro dominio, por ejemplo en produccion.
VITE_API_URL=
VITE_WS_URL=

# Estilo de mapa vectorial para MapLibre. Por defecto OpenFreeMap (gratis, sin API key, basado en
# OpenStreetMap). Alternativas con free tier si se necesita mas soporte/SLA: MapTiler, Stadia Maps
# (ambas requieren key propia y se pondria aqui la URL de su style, sin cambiar codigo).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Intervalo minimo (ms) entre actualizaciones de posicion GPS que la app procesa.
VITE_LOCATION_UPDATE_MS=5000

# Intervalo (ms) de refresco de "taxis disponibles cercanos" en el mapa del pasajero.
VITE_NEARBY_DRIVERS_POLL_MS=8000
