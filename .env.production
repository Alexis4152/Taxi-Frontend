# URLs publicas del backend en produccion. Vite las lee automaticamente al compilar con
# `npm run build` (modo production), sin depender de que Coolify pase las variables de entorno
# correctamente al proceso de build.
# OJO: VITE_API_URL es el ORIGEN del backend, sin "/api" (el codigo ya llama a /api/..., /uploads/...).
VITE_API_URL=https://api-taxi.nexorasistemas.com.mx
VITE_WS_URL=https://api-taxi.nexorasistemas.com.mx/ws
